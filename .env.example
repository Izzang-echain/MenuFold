# 复制此文件为 .env，再填入自己的密钥。
# 密钥只在服务器使用，不要发到聊天、写进 HTML 或提交到仓库。
MENU_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# DeepSeek API 按用量从可用余额扣费；免费托管不包含模型费用。
# Key 在 https://platform.deepseek.com/api_keys 创建，余额不足时需充值。
# 可选：改为 MENU_PROVIDER=gemini 后，取消下面注释并填写 Gemini 配置。
# GEMINI_API_KEY=
# GOOGLE_API_KEY 也可使用；若二者均设置，优先 GEMINI_API_KEY。
# GEMINI_MODEL=gemini-3.5-flash-lite

# 本机默认设置。Docker 会通过命令行指定 0.0.0.0。
HOST=127.0.0.1
PORT=8765

# Render 默认域名会自动允许。其他域名填写在此，多个用逗号分隔；不要带协议或路径。
# MENU_ALLOWED_HOSTS=menu.example.com

# 单进程保护限额；每日按 UTC 计算，重启会重置。
MENU_MAX_CONCURRENT=1
MENU_DAILY_REQUEST_LIMIT=30
MENU_CLIENT_HOURLY_LIMIT=6
MENU_DAILY_MODEL_CALL_LIMIT=100
